# Copy to .env (never commit .env) or export these variables in your shell.
# RouteGuard never reads keys from config files; configs only name the variable via `api_key_env`.

# Key for a hosted OpenAI-compatible provider (see configs/openai_compatible.yaml)
ROUTEGUARD_API_KEY=

# Hugging Face token, only needed for gated models/datasets (e.g. FLORES+)
HF_TOKEN=

# Comma-separated browser origins allowed to call the FastAPI service.
ROUTEGUARD_CORS_ORIGINS=http://localhost:3000

# Interpreter used by scripts/run_web.sh when the project is not in ./.venv (e.g. conda).
# ROUTEGUARD_PYTHON=/path/to/python

# The frontend reads its own variables from apps/web/.env.local; see apps/web/.env.example.
# NEXT_PUBLIC_API_URL is baked into the browser bundle at build time, so it must never
# hold a secret.

# Keep PyTorch on standard kernels (set automatically by the HF backend; 0 opts back in)
# TORCH_DISABLE_NATIVE_JIT=1
